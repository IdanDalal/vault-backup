filters:
  and:
    - file.ext == "md"
    - or:
        - type == "literature"
        - type == "fleeting"
        - file.inFolder("atomic-notes")
properties:
  file.name:
    displayName: Note
  note.type:
    displayName: Kind
  note.by:
    displayName: By
  note.medium:
    displayName: Medium
  note.length_min:
    displayName: Minutes
  note.evidence:
    displayName: Evidence
  note.source:
    displayName: Source
  note.processed:
    displayName: Processed
  note.up:
    displayName: Up
  note.maturity:
    displayName: Maturity
views:
  - type: table
    name: Morning
    filters:
      and:
        - processed != true
        - or:
            - type == "literature"
            - type == "fleeting"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - processed
  - type: table
    name: Literature
    filters:
      and:
        - type == "literature"
    groupBy:
      property: by
      direction: ASC
    order:
      - file.name
      - processed
      - medium
      - length_min
      - evidence
      - source
  - type: table
    name: Atomic
    filters:
      and:
        - file.inFolder("atomic-notes")
    order:
      - file.name
      - up
      - maturity
      - file.mtime
  - type: table
    name: Fleeting
    filters:
      and:
        - type == "fleeting"
    order:
      - file.name
      - processed
      - file.ctime
