//---------------------------------------------------------------------------------------
//  jepClassWeights, 2026-11-08, built by jep for Idi.
//  Sets NumInDeck on listed Amalgamation classes. Choose My Class gives every class
//  Max(NumInDeck, 1) tickets in its draw pool (UIChooseClass_WOTC_ChooseMyClass.uc:372),
//  so rare specs show up more often. Classes at NumInDeck 0 (Amalgamation DisableClass)
//  are never touched, whichever OnPostTemplatesCreated runs first.
//  Weights are generated by jep's amalgamation-tools/weights5.py: each class gets the
//  rarity boost of its rarest spec (P, S or T), capped at 50; secondaries held to <=8 %.
//---------------------------------------------------------------------------------------
class X2DownloadableContentInfo_jepClassWeights extends X2DownloadableContentInfo config(jepClassWeights);

struct ClassTickets
{
	var name ClassName;
	var int Tickets;
};

var config array<ClassTickets> Weights;

static event OnLoadedSavedGame()
{
}

static event InstallNewCampaign(XComGameState StartState)
{
}

static event OnPostTemplatesCreated()
{
	local X2SoldierClassTemplateManager Mgr;
	local array<X2DataTemplate> TemplateArray;
	local X2DataTemplate DataTemplate;
	local X2SoldierClassTemplate ClassTemplate;
	local ClassTickets Entry;
	local int NumSet, NumDisabled, NumMissing;

	Mgr = class'X2SoldierClassTemplateManager'.static.GetSoldierClassTemplateManager();

	foreach default.Weights(Entry)
	{
		Mgr.FindDataTemplateAllDifficulties(Entry.ClassName, TemplateArray);
		if (TemplateArray.Length == 0)
		{
			NumMissing++;
			continue;
		}
		foreach TemplateArray(DataTemplate)
		{
			ClassTemplate = X2SoldierClassTemplate(DataTemplate);
			if (ClassTemplate == none)
				continue;
			if (ClassTemplate.NumInDeck <= 0)
			{
				NumDisabled++;
				continue;
			}
			ClassTemplate.NumInDeck = Max(Entry.Tickets, 1);
			NumSet++;
		}
	}

	`log("jepClassWeights: set" @ NumSet @ "classes, skipped disabled" @ NumDisabled @ ", missing" @ NumMissing @ "of" @ default.Weights.Length, , 'jepClassWeights');
}
