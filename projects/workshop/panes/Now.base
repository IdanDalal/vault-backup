filters:
  and:
    - type == "hub"
    - file.ext == "md"
formulas:
  quiet_days: if(last, ((number(today()) - number(date(last))) / 86400000).round(0), "")
  quadrant: if(value == "high", if(effort == "low", "1 High value, low effort", "2 High value, high effort"), if(effort == "low", "3 Low value, low effort", "4 Low value, high effort"))
properties:
  file.name:
    displayName: Project
  note.next:
    displayName: Next step
  note.ball:
    displayName: Whose move
  note.cost_min:
    displayName: Idi minutes
  note.status:
    displayName: Status
  formula.quiet_days:
    displayName: Days quiet
  formula.quadrant:
    displayName: Quadrant
views:
  - type: table
    name: Now
    filters:
      and:
        - status == "active"
    groupBy:
      property: ball
      direction: ASC
    order:
      - file.name
      - next
      - cost_min
      - formula.quiet_days
    columnSize:
      note.next: 1093
